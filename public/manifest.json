{
  "manifest_version": 3,
  "name": "WhatsApp Sender",
  "version": "1.0.54",
  "description": "Puente de automatización para envío secuencial de WhatsApp.",
  "author": "SystemAlex",
  "homepage_url": "https://github.com/SystemAlex/WhatsappSender",
  "minimum_chrome_version": "88",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["*://web.whatsapp.com/*", "<all_urls>"],
  "action": {
    "default_title": "Abrir WhatsApp Sender",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
